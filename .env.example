# Web3Forms access key for the contact form.
# Get one free at https://web3forms.com — enter your email, and the key
# is mailed to you. Copy this file to `.env` and paste the key below.
#
# This value is bundled into the client build (that is how Web3Forms
# works); it only allows submissions to your own inbox.
VITE_WEB3FORMS_KEY=your-access-key-here
